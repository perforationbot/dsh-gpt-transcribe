{
  "name": "@deepseek-ai/dsh-speech-to-text-openai",
  "description": "OpenAI GPT Transcribe cloud transcription for voice input",
  "version": "0.2.1-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.1-rc.3",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.3"
  }
}
