+++ b/packages/experimental/speech-to-text-openai/src/error.ts
@@ -0,0 +1,26 @@
+/** Stable failures from the OpenAI GPT Transcribe provider, safe to show in the voice input UI. */
+export type GptTranscribeErrorCode =
+  | 'GPT_TRANSCRIBE_MISSING_CREDENTIAL'
+  | 'GPT_TRANSCRIBE_INVALID_AUDIO'
+  | 'GPT_TRANSCRIBE_UNSUPPORTED_LANGUAGE'
+  | 'GPT_TRANSCRIBE_AUDIO_TOO_LARGE'
+  | 'GPT_TRANSCRIBE_AUTH'
+  | 'GPT_TRANSCRIBE_RATE_LIMIT'
+  | 'GPT_TRANSCRIBE_HTTP'
+  | 'GPT_TRANSCRIBE_TIMEOUT'
+  | 'GPT_TRANSCRIBE_REQUEST_FAILED'
+  | 'GPT_TRANSCRIBE_RESPONSE_LIMIT'
+  | 'GPT_TRANSCRIBE_INVALID_RESPONSE'
+
+/** A provider-owned failure that names a stable recovery category without exposing credentials or audio. */
+export class GptTranscribeError extends Error {
+  /**
+   * @param code - stable failure category.
+   * @param message - actionable text safe to display.
+   * @param options - retained local cause, excluded from the public message.
+   */
+  constructor(readonly code: GptTranscribeErrorCode, message: string, options?: ErrorOptions) {
+    super(message, options)
+    this.name = 'GptTranscribeError'
+  }
+}
