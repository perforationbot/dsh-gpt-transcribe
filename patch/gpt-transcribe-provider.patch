diff --git a/packages/experimental/speech-to-text-openai/src/recognizer.ts b/packages/experimental/speech-to-text-openai/src/recognizer.ts
new file mode 100644
index 00000000..cb005533
--- /dev/null
+++ b/packages/experimental/speech-to-text-openai/src/recognizer.ts
@@ -0,0 +1,178 @@
+/** OpenAI GPT Transcribe cloud recognizer: one bounded multipart request per complete recording. */
+import type { Context } from '@deepseek-ai/cordis'
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+import { launchEnvironmentOf } from '@deepseek-ai/dsh-launch-environment'
+import { deadline, timeoutOf } from '@deepseek-ai/dsh-timeout'
+import type { SpeechInput, Transcript } from '@deepseek-ai/dsh-experimental-speech-to-text/types'
+import { validateWave } from '@deepseek-ai/dsh-experimental-speech-to-text/wave'
+import type { Config } from './config.ts'
+import { GptTranscribeError } from './error.ts'
+import { languages } from './languages.ts'
+
+/** The one file-transcription model this provider addresses. */
+const MODEL = 'gpt-transcribe'
+const TIMEOUT_CODE = 'GPT_TRANSCRIBE_TIMEOUT'
+
+/**
+ * Read a response body without retaining more than the configured bound.
+ * @param response - successful transcription response.
+ * @param maxBytes - maximum accepted UTF-8 response bytes.
+ * @returns the complete response text.
+ */
+async function readText(response: Response, maxBytes: number): Promise<string> {
+  if (response.body === null) {
+    throw new GptTranscribeError('GPT_TRANSCRIBE_INVALID_RESPONSE', 'OpenAI GPT Transcribe returned an empty response body')
+  }
+  const reader = response.body.getReader()
+  const chunks: Uint8Array[] = []
+  let bytes = 0
+  try {
+    while (true) {
+      const chunk = await reader.read()
+      if (chunk.done) break
+      bytes += chunk.value.byteLength
+      if (bytes > maxBytes) {
+        await reader.cancel()
+        throw new GptTranscribeError('GPT_TRANSCRIBE_RESPONSE_LIMIT', `OpenAI GPT Transcribe response exceeds ${maxBytes} bytes`)
+      }
+      chunks.push(chunk.value)
+    }
+  } finally {
+    reader.releaseLock()
+  }
+  return Buffer.concat(chunks).toString('utf8')
+}
+
+/**
+ * Read the transcript from a JSON response, rejecting every other document.
+ * @param raw - complete response text.
+ * @returns the transcribed text, including an empty result for silence.
+ */
+function transcriptOf(raw: string): string {
+  let payload: unknown
+  try {
+    payload = JSON.parse(raw)
+  } catch (error) {
+    throw new GptTranscribeError('GPT_TRANSCRIBE_INVALID_RESPONSE', 'OpenAI GPT Transcribe returned invalid JSON', { cause: error })
+  }
+  if (typeof payload !== 'object' || payload === null || !('text' in payload) || typeof payload.text !== 'string') {
+    throw new GptTranscribeError('GPT_TRANSCRIBE_INVALID_RESPONSE', 'OpenAI GPT Transcribe returned no transcript text')
+  }
+  return payload.text
+}
+
+/** One stateless provider implementation; each recording resolves its own credential and request. */
+export class GptTranscribeRecognizer {
+  /**
+   * @param ctx - Host context that supplies credentials and the launch environment.
+   * @param config - validated endpoint, credential reference, and request bounds.
+   */
+  constructor(private readonly ctx: Context, private readonly config: Config) {}
+
+  /**
+   * Transcribe one complete recording through the OpenAI transcription endpoint.
+   * @param input - canonical WAV bytes and an accepted language hint.
+   * @param signal - caller cancellation or provider withdrawal.
+   * @returns final text and measured audio and request durations.
+   */
+  async transcribe(input: SpeechInput, signal: AbortSignal): Promise<Transcript> {
+    signal.throwIfAborted()
+    const audioSeconds = this.validate(input)
+    const apiKey = await this.apiKey()
+    signal.throwIfAborted()
+    using timeout = deadline(signal, this.config.timeoutMs, TIMEOUT_CODE)
+    const started = performance.now()
+    try {
+      const response = await fetch(this.config.endpoint, {
+        method: 'POST',
+        headers: { authorization: `Bearer ${apiKey}` },
+        body: this.requestBody(input),
+        redirect: 'error',
+        credentials: 'omit',
+        signal: timeout.signal,
+      })
+      if (!response.ok) {
+        await response.body?.cancel()
+        throw this.httpError(response.status)
+      }
+      const text = transcriptOf(await readText(response, this.config.maxResponseBytes))
+      timeout.signal.throwIfAborted()
+      return { text, audioSeconds, inferenceSeconds: (performance.now() - started) / 1000 }
+    } catch (error) {
+      const expired = timeoutOf(timeout.signal, TIMEOUT_CODE)
+      if (expired !== undefined && expired !== signal.reason) {
+        throw new GptTranscribeError('GPT_TRANSCRIBE_TIMEOUT', `OpenAI GPT Transcribe timed out after ${expired.timeoutMs}ms`, { cause: error })
+      }
+      timeout.signal.throwIfAborted()
+      if (error instanceof GptTranscribeError) throw error
+      throw new GptTranscribeError('GPT_TRANSCRIBE_REQUEST_FAILED', 'OpenAI GPT Transcribe request failed', { cause: error })
+    }
+  }
+
+  /**
+   * Validate language, size, and the canonical WAV header before any network I/O.
+   * @param input - recording and requested language hint.
+   * @returns recording duration in seconds.
+   */
+  private validate(input: SpeechInput): number {
+    if (!languages.includes(input.language)) {
+      throw new GptTranscribeError('GPT_TRANSCRIBE_UNSUPPORTED_LANGUAGE', `GPT Transcribe does not support language: ${input.language}`)
+    }
+    if (input.audio.byteLength > this.config.maxAudioBytes) {
+      throw new GptTranscribeError('GPT_TRANSCRIBE_AUDIO_TOO_LARGE', `Recording exceeds ${this.config.maxAudioBytes} bytes`)
+    }
+    try {
+      return validateWave(input.audio, this.config.maxAudioBytes / 32000)
+    } catch (error) {
+      throw new GptTranscribeError('GPT_TRANSCRIBE_INVALID_AUDIO', 'GPT Transcribe requires a canonical 16 kHz mono PCM16 WAV recording', { cause: error })
+    }
+  }
+
+  /**
+   * Resolve the configured credential reference through the credentials service, or the launch environment without it.
+   * @returns the API key used only in the authorization header for this request.
+   */
+  private async apiKey(): Promise<string> {
+    const reference = credentialRef(this.config.apiKeyEnv)
+    const credentials = this.ctx.get('credentials')
+    const value = credentials === undefined
+      ? launchEnvironmentOf(this.ctx).get(this.config.apiKeyEnv)?.value
+      : (await credentials.resolve(reference))?.value
+    if (value === undefined || value === '') {
+      throw new GptTranscribeError('GPT_TRANSCRIBE_MISSING_CREDENTIAL',
+        `GPT Transcribe requires ${this.config.apiKeyEnv}; store it through the credentials service or export it in the launching environment`)
+    }
+    return value
+  }
+
+  /**
+   * Encode one multipart request; `languages[]` carries the single selected hint and is omitted for automatic detection.
+   * @param input - validated recording and language hint.
+   * @returns the request body sent to the configured endpoint.
+   */
+  private requestBody(input: SpeechInput): FormData {
+    const form = new FormData()
+    form.append('model', MODEL)
+    form.append('file', new Blob([input.audio.slice()], { type: 'audio/wav' }), 'recording.wav')
+    if (input.language !== 'auto') form.append('languages[]', input.language)
+    return form
+  }
+
+  /**
+   * Map an unsuccessful response to an actionable failure without exposing its body.
+   * @param status - HTTP status from the transcription endpoint.
+   * @returns the categorized public failure.
+   */
+  private httpError(status: number): GptTranscribeError {
+    if (status === 401 || status === 403) {
+      return new GptTranscribeError('GPT_TRANSCRIBE_AUTH', `OpenAI rejected ${this.config.apiKeyEnv} (HTTP ${status})`)
+    }
+    if (status === 413) {
+      return new GptTranscribeError('GPT_TRANSCRIBE_AUDIO_TOO_LARGE', 'OpenAI rejected the recording as too large (HTTP 413)')
+    }
+    if (status === 429) {
+      return new GptTranscribeError('GPT_TRANSCRIBE_RATE_LIMIT', 'OpenAI rate limited the transcription request (HTTP 429)')
+    }
+    return new GptTranscribeError('GPT_TRANSCRIBE_HTTP', `OpenAI GPT Transcribe failed (HTTP ${status})`)
+  }
+}
diff --git a/packages/experimental/speech-to-text-openai/tests/provider.spec.ts b/packages/experimental/speech-to-text-openai/tests/provider.spec.ts
new file mode 100644
index 00000000..99b920ea
--- /dev/null
+++ b/packages/experimental/speech-to-text-openai/tests/provider.spec.ts
@@ -0,0 +1,263 @@
+/** GPT Transcribe registration, request construction, credential resolution, and bounded failure handling. */
+import { Context } from '@deepseek-ai/cordis'
+import SpeechToText from '@deepseek-ai/dsh-experimental-speech-to-text'
+import type { SpeechProviderId } from '@deepseek-ai/dsh-experimental-speech-to-text/types'
+import { afterEach, expect, it, vi } from 'vitest'
+import * as Provider from '../src/index.ts'
+import { GptTranscribeError } from '../src/error.ts'
+import { GptTranscribeRecognizer } from '../src/recognizer.ts'
+
+const roots: Context[] = []
+const signal = new AbortController().signal
+
+afterEach(async () => {
+  vi.unstubAllGlobals()
+  vi.unstubAllEnvs()
+  vi.useRealTimers()
+  await Promise.all(roots.splice(0).map(ctx => ctx.fiber.dispose()))
+})
+
+/** Build one canonical 16 kHz mono PCM16 WAV recording with the requested sample count. */
+function wav(samples = 160): Uint8Array {
+  const bytes = Buffer.alloc(44 + samples * 2)
+  bytes.write('RIFF'); bytes.writeUInt32LE(bytes.length - 8, 4); bytes.write('WAVEfmt ', 8)
+  bytes.writeUInt32LE(16, 16); bytes.writeUInt16LE(1, 20); bytes.writeUInt16LE(1, 22)
+  bytes.writeUInt32LE(16000, 24); bytes.writeUInt32LE(32000, 28); bytes.writeUInt16LE(2, 32)
+  bytes.writeUInt16LE(16, 34); bytes.write('data', 36); bytes.writeUInt32LE(samples * 2, 40)
+  return bytes
+}
+
+type FetchCall = { input: RequestInfo | URL; init: RequestInit | undefined }
+
+/** Replace the global fetch and retain every call for request assertions. */
+function stubFetch(respond: (call: FetchCall) => Response | Promise<Response>): FetchCall[] {
+  const calls: FetchCall[] = []
+  vi.stubGlobal('fetch', vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+    const call = { input, init }
+    calls.push(call)
+    return await respond(call)
+  }))
+  return calls
+}
+
+function json(text: string, status = 200): Response {
+  return new Response(JSON.stringify({ text }), { status, headers: { 'content-type': 'application/json' } })
+}
+
+function formOf(call: FetchCall): FormData {
+  return call.init?.body as FormData
+}
+
+/** Read the deadline-fused signal the provider passes to fetch. */
+function fetchSignal(init: RequestInit | undefined): AbortSignal {
+  const signalValue = init?.signal
+  if (signalValue === undefined || signalValue === null) throw new Error('fetch request signal is required')
+  return signalValue
+}
+
+interface MountOptions {
+  readonly config?: Partial<Provider.Config>
+  readonly credentials?: 'service' | 'environment' | 'none'
+  readonly key?: string
+}
+
+async function mount(options: MountOptions = {}) {
+  const ctx = new Context()
+  roots.push(ctx)
+  if (options.credentials === 'service') {
+    ctx.provide('credentials', { resolve: async () => options.key === undefined ? undefined : { value: options.key, source: 'stored' } } as never)
+  }
+  const speech = new SpeechToText(ctx, SpeechToText.Config({ defaultProvider: 'gpt-transcribe', language: 'auto' }))
+  const fiber = ctx.plugin(Provider, Provider.Config({ ...options.config }))
+  await fiber
+  return { ctx, speech, fiber }
+}
+
+function recognizer(config: Partial<Provider.Config> = {}): GptTranscribeRecognizer {
+  const ctx = new Context()
+  roots.push(ctx)
+  return new GptTranscribeRecognizer(ctx, Provider.Config({ ...config }))
+}
+
+it('validates endpoint, credential reference, and request bounds', () => {
+  expect(Provider.Config({})).toEqual({
+    providerId: 'gpt-transcribe',
+    apiKeyEnv: 'OPENAI_API_KEY',
+    endpoint: 'https://api.openai.com/v1/audio/transcriptions',
+    maxAudioBytes: 25 * 1024 * 1024,
+    timeoutMs: 300_000,
+    maxResponseBytes: 1024 * 1024,
+  })
+  expect(Provider.Config({ endpoint: 'https://example.com/transcribe?tenant=1' }).endpoint).toBe('https://example.com/transcribe?tenant=1')
+  for (const endpoint of ['ftp://example.com/transcribe', 'https://user@example.com/transcribe', 'https://:secret@example.com/transcribe', 'https://example.com/transcribe#fragment']) {
+    expect(() => Provider.Config({ endpoint })).toThrow('HTTP(S) URL without credentials or a fragment')
+  }
+  expect(() => Provider.Config({ apiKeyEnv: 'not a reference' })).toThrow()
+  expect(() => Provider.Config({ maxAudioBytes: 45 })).toThrow()
+  expect(() => Provider.Config({ maxAudioBytes: 25 * 1024 * 1024 + 1 })).toThrow()
+  expect(() => Provider.Config({ timeoutMs: 0 })).toThrow()
+  expect(() => Provider.Config({ maxResponseBytes: 0 })).toThrow()
+})
+
+it('registers a ready cloud provider under its configured id and withdraws it on disposal', async () => {
+  const { speech, fiber } = await mount({ config: { providerId: 'openai-gpt' }, credentials: 'service', key: 'sk-test' })
+  expect(speech.listProviders()).toEqual([{
+    id: 'openai-gpt', name: 'GPT Transcribe', location: 'cloud',
+    languages: ['auto', 'zh', 'yue', 'en', 'ja', 'ko', 'es', 'fr', 'de', 'ru', 'pt'],
+  }])
+  expect(speech.snapshot()).toMatchObject({
+    providers: [{ id: 'openai-gpt', preparation: { phase: 'ready' } }],
+    selection: { providerId: 'gpt-transcribe', language: 'auto' },
+  })
+  await fiber.dispose()
+  expect(speech.listProviders()).toEqual([])
+})
+
+it('sends one bounded multipart request with automatic language and returns the transcript', async () => {
+  const { speech } = await mount({ credentials: 'service', key: 'sk-test' })
+  const audio = wav()
+  const calls = stubFetch(() => json('hello world'))
+  const transcript = await speech.transcribe(speech.resolve({ audio }), signal)
+  expect(transcript).toMatchObject({ text: 'hello world', audioSeconds: 0.01 })
+  expect(transcript.inferenceSeconds).toBeGreaterThanOrEqual(0)
+  expect(calls).toHaveLength(1)
+  const [call] = calls
+  expect(call?.input).toBe('https://api.openai.com/v1/audio/transcriptions')
+  expect(call?.init).toMatchObject({ method: 'POST', redirect: 'error', credentials: 'omit', headers: { authorization: 'Bearer sk-test' } })
+  const form = formOf(call!)
+  expect(form.get('model')).toBe('gpt-transcribe')
+  expect(form.get('languages[]')).toBeNull()
+  const file = form.get('file') as File
+  expect(file.name).toBe('recording.wav')
+  expect(file.type).toBe('audio/wav')
+  expect(file.size).toBe(audio.byteLength)
+})
+
+it('sends the selected language as a single languages[] hint', async () => {
+  const { speech } = await mount({ credentials: 'service', key: 'sk-test' })
+  const calls = stubFetch(() => json('你好'))
+  expect(await speech.transcribe(speech.resolve({ audio: wav(), language: 'yue' }), signal)).toMatchObject({ text: '你好' })
+  expect(formOf(calls[0]!).get('languages[]')).toBe('yue')
+})
+
+it('uses a custom endpoint, credential reference, and provider id', async () => {
+  const { speech } = await mount({
+    config: { providerId: 'openai-cloud', apiKeyEnv: 'CUSTOM_OPENAI_KEY', endpoint: 'http://127.0.0.1:9/transcribe' },
+    credentials: 'service', key: 'sk-custom',
+  })
+  const calls = stubFetch(() => json('custom'))
+  expect(await speech.transcribe(speech.resolve({ audio: wav(), providerId: 'openai-cloud' as SpeechProviderId }), signal)).toMatchObject({ text: 'custom' })
+  expect(calls[0]?.input).toBe('http://127.0.0.1:9/transcribe')
+  expect(calls[0]?.init?.headers).toEqual({ authorization: 'Bearer sk-custom' })
+  expect(speech.listProviders()[0]?.id).toBe('openai-cloud')
+})
+
+it('falls back to the launch environment when the credentials service is absent', async () => {
+  vi.stubEnv('CUSTOM_OPENAI_KEY', 'sk-environment')
+  const { speech } = await mount({ config: { apiKeyEnv: 'CUSTOM_OPENAI_KEY' }, credentials: 'none' })
+  const calls = stubFetch(() => json('environment'))
+  expect(await speech.transcribe(speech.resolve({ audio: wav() }), signal)).toMatchObject({ text: 'environment' })
+  expect(calls[0]?.init?.headers).toEqual({ authorization: 'Bearer sk-environment' })
+})
+
+it.each([
+  { name: 'absent from the credentials service', options: { credentials: 'service' as const } },
+  { name: 'empty in the credentials service', options: { credentials: 'service' as const, key: '' } },
+  { name: 'empty in the launch environment', options: { credentials: 'none' as const }, env: '' },
+  { name: 'absent from the launch environment', options: { credentials: 'none' as const } },
+])('fails before network I/O when the credential is $name', async ({ options, env }) => {
+  if (env !== undefined) vi.stubEnv('OPENAI_API_KEY', env)
+  const { speech } = await mount(options)
+  const calls = stubFetch(() => json('unreachable'))
+  const operation = speech.transcribe(speech.resolve({ audio: wav() }), signal)
+  await expect(operation).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_MISSING_CREDENTIAL' })
+  await expect(operation).rejects.toThrow('OPENAI_API_KEY')
+  expect(calls).toHaveLength(0)
+})
+
+it('rejects unsupported languages, noncanonical audio, oversized audio, and overlong recordings', async () => {
+  const credential = recognizer()
+  await expect(credential.transcribe({ audio: wav(), language: 'xx' }, signal)).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_UNSUPPORTED_LANGUAGE' })
+  await expect(credential.transcribe({ audio: new Uint8Array(46), language: 'auto' }, signal)).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_INVALID_AUDIO' })
+  await expect(recognizer({ maxAudioBytes: 100 }).transcribe({ audio: wav(), language: 'auto' }, signal))
+    .rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_AUDIO_TOO_LARGE' })
+})
+
+it.each([
+  [401, 'GPT_TRANSCRIBE_AUTH'],
+  [403, 'GPT_TRANSCRIBE_AUTH'],
+  [413, 'GPT_TRANSCRIBE_AUDIO_TOO_LARGE'],
+  [429, 'GPT_TRANSCRIBE_RATE_LIMIT'],
+  [400, 'GPT_TRANSCRIBE_HTTP'],
+  [500, 'GPT_TRANSCRIBE_HTTP'],
+])('maps HTTP %s to %s without exposing the response body', async (status, code) => {
+  const { speech } = await mount({ credentials: 'service', key: 'sk-test' })
+  stubFetch(() => new Response('private provider text', { status }))
+  await expect(speech.transcribe(speech.resolve({ audio: wav() }), signal)).rejects.toMatchObject({ code })
+})
+
+it.each([
+  ['invalid JSON', 'not json'],
+  ['a JSON scalar', '42'],
+  ['JSON null', 'null'],
+  ['a missing text field', '{}'],
+  ['a non-string text field', '{"text":42}'],
+])('rejects %s as an invalid response', async (_name, body) => {
+  const { speech } = await mount({ credentials: 'service', key: 'sk-test' })
+  stubFetch(() => new Response(body))
+  await expect(speech.transcribe(speech.resolve({ audio: wav() }), signal)).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_INVALID_RESPONSE' })
+})
+
+it('rejects an empty response body and an oversized response body', async () => {
+  const { speech } = await mount({ credentials: 'service', key: 'sk-test' })
+  stubFetch(() => new Response(null))
+  await expect(speech.transcribe(speech.resolve({ audio: wav() }), signal)).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_INVALID_RESPONSE' })
+  const limited = await mount({ config: { maxResponseBytes: 10 }, credentials: 'service', key: 'sk-test' })
+  stubFetch(() => new Response('12345678901'))
+  await expect(limited.speech.transcribe(limited.speech.resolve({ audio: wav() }), signal)).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_RESPONSE_LIMIT' })
+})
+
+it('wraps a network failure and a response-stream failure', async () => {
+  const { speech } = await mount({ credentials: 'service', key: 'sk-test' })
+  stubFetch(() => { throw new TypeError('fetch failed') })
+  await expect(speech.transcribe(speech.resolve({ audio: wav() }), signal)).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_REQUEST_FAILED' })
+  stubFetch(() => new Response(new ReadableStream<Uint8Array>({ start(controller) { controller.error(new Error('broken stream')) } })))
+  await expect(speech.transcribe(speech.resolve({ audio: wav() }), signal)).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_REQUEST_FAILED' })
+})
+
+it('preserves a caller cancellation before and during the request', async () => {
+  const { speech } = await mount({ credentials: 'service', key: 'sk-test' })
+  const reason = new Error('cancelled before start')
+  await expect(speech.transcribe(speech.resolve({ audio: wav() }), AbortSignal.abort(reason))).rejects.toBe(reason)
+
+  const controller = new AbortController()
+  const calls = stubFetch(({ init }) => new Promise<Response>((_resolve, reject) => {
+    fetchSignal(init).addEventListener('abort', () => { reject(new Error('fetch aborted')) })
+  }))
+  const operation = speech.transcribe(speech.resolve({ audio: wav() }), controller.signal)
+  const rejection = expect(operation).rejects.toThrow('cancelled during request')
+  await vi.waitFor(() => { expect(calls).toHaveLength(1) })
+  controller.abort(new Error('cancelled during request'))
+  await rejection
+})
+
+it('maps its own deadline to a timeout failure', async () => {
+  const { speech } = await mount({ config: { timeoutMs: 50 }, credentials: 'service', key: 'sk-test' })
+  vi.useFakeTimers()
+  stubFetch(({ init }) => new Promise<Response>((_resolve, reject) => {
+    fetchSignal(init).addEventListener('abort', () => { reject(new Error('fetch aborted')) })
+  }))
+  const operation = speech.transcribe(speech.resolve({ audio: wav() }), signal)
+  const rejection = expect(operation).rejects.toMatchObject({ code: 'GPT_TRANSCRIBE_TIMEOUT' })
+  const message = expect(operation).rejects.toThrow('50ms')
+  await vi.advanceTimersByTimeAsync(0)
+  await vi.advanceTimersByTimeAsync(60)
+  await rejection
+  await message
+})
+
+it('exposes its typed failure class', () => {
+  const failure = new GptTranscribeError('GPT_TRANSCRIBE_HTTP', 'failed', { cause: new Error('cause') })
+  expect(failure).toMatchObject({ name: 'GptTranscribeError', code: 'GPT_TRANSCRIBE_HTTP', message: 'failed' })
+  expect(failure.cause).toBeInstanceOf(Error)
+})
